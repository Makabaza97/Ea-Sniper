<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Todo List"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1976d2"
        android:layout_marginBottom="16dp" />

    <!-- Input Section -->
    <androidx.cardview.widget.CardView xmlns:card="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        card:cardElevation="4dp"
        card:cardCornerRadius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Todo title"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/edit_text_background"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Description (optional)"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/edit_text_background"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Spinner
                    android:id="@+id/prioritySpinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/categoryInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Category"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/edit_text_background" />

            </LinearLayout>

            <Button
                android:id="@+id/addButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Add Todo"
                android:textColor="#ffffff"
                android:backgroundTint="#4caf50" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Stats and Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/activeCountTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Active: 0"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center_vertical" />

        <Button
            android:id="@+id/clearCompletedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Clear Completed"
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:backgroundTint="#f44336" />

    </LinearLayout>

    <!-- Filter Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/filterAllButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="All"
            android:textColor="#ffffff"
            android:backgroundTint="#1976d2"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/filterActiveButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Active"
            android:textColor="#ffffff"
            android:backgroundTint="#666666"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/filterCompletedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Completed"
            android:textColor="#ffffff"
            android:backgroundTint="#666666" />

    </LinearLayout>

    <!-- Todos RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/todoRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
