<?xml version="1.0" encoding="utf-8"?>
<CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    card:cardBackgroundColor="#ffffff"
    card:cardElevation="4dp"
    card:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Zone Name and Remove Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/zoneNameTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="America/New_York"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1976d2" />

            <Button
                android:id="@+id/removeButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Remove"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:backgroundTint="#d32f2f"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <!-- Time Display -->
        <TextView
            android:id="@+id/zoneTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:30:45"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <!-- Date Display -->
        <TextView
            android:id="@+id/zoneDetailsTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuesday, Jun 10, 2025"
            android:textSize="12sp"
            android:textColor="#666666" />

    </LinearLayout>

</CardView>
